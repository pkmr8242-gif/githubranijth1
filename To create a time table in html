            <th>Monday</th><td>Devops</td><td>NNDL</td><td>DCC</td>
        </tr>
        <tr>
            <th>Tuesday</th><td>DCC</td><td>WT</td><td>OF</td>
        </tr>
        <tr>
            <th>Wednesday</th><td>OF</td><td colspan="2">NNDL Lab</td>
        </tr>
        <tr>
            <th>Thuresday</th><td colspan="2">WT Lab</td><td>Devops</td>
        </tr>
        <tr>
            <th>Friday</th><td>Devops</td><td>ESIOT</td><td>DCC</td>
        </tr>
        <tr>
            <th>Saturday</th><td>OF</td><td colspan="2">ESIOT Lab</td>
        </tr>
    </table>
    </center>
</body>
</html>
